{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "standard_meta": {
    "standard_id": "GB/T 13296-2023",
    "standard_name": "锅炉、热交换器用不锈钢无缝钢管",
    "version": "2023",
    "description": "【Phase 1 测试基准样本 / 部分牌号用例】本文件包含 06Cr19Ni10 (S30408) 与 07Cr19Ni11Ti (S32169) 两个典型牌号的完整结构化核验规则，用于 Phase 1 核心算法与测试用例验证。非全量 31 个牌号生产数据。",
    "status": "CURRENT",
    "material_category": "ferrous_pipe",
    "applies_to_forms": ["tube_seamless"]
  },
  "grade_rules": [
    {
      "grade_info": {
        "primary_grade": "06Cr19Ni10",
        "unified_code": "S30408",
        "structure_type": "austenitic",
        "aliases": ["SUS304", "TP304", "0Cr18Ni9"]
      },
      "description": "06Cr19Ni10 (S30408) 常用奥氏体不锈钢无缝钢管，适用于锅炉管与管壳式换热管，具备优良的耐蚀与焊接性能",
      "evaluation_rules": [
        {
          "rule_id": "CHEM_06Cr19Ni10_C",
          "category": "chemical",
          "property_key": "C",
          "display_name": "碳含量 (C)",
          "description": "依据 GB/T 13296-2023 表3，06Cr19Ni10 熔炼分析碳质量分数应 <= 0.08%",
          "rule_type": "numeric_range",
          "requirement_level": "MANDATORY",
          "criteria": { "min": null, "max": 0.08, "unit": "%", "rounding_decimals": 3 }
        },
        {
          "rule_id": "CHEM_06Cr19Ni10_Si",
          "category": "chemical",
          "property_key": "Si",
          "display_name": "硅含量 (Si)",
          "description": "依据 GB/T 13296-2023 表3，硅质量分数应 <= 1.00%",
          "rule_type": "numeric_range",
          "requirement_level": "MANDATORY",
          "criteria": { "min": null, "max": 1.00, "unit": "%", "rounding_decimals": 2 }
        },
        {
          "rule_id": "CHEM_06Cr19Ni10_Mn",
          "category": "chemical",
          "property_key": "Mn",
          "display_name": "锰含量 (Mn)",
          "description": "依据 GB/T 13296-2023 表3，锰质量分数应 <= 2.00%",
          "rule_type": "numeric_range",
          "requirement_level": "MANDATORY",
          "criteria": { "min": null, "max": 2.00, "unit": "%", "rounding_decimals": 2 }
        },
        {
          "rule_id": "CHEM_06Cr19Ni10_P",
          "category": "chemical",
          "property_key": "P",
          "display_name": "磷含量 (P)",
          "description": "依据 GB/T 13296-2023 表3，有害杂质元素磷质量分数应 <= 0.035%",
          "rule_type": "numeric_range",
          "requirement_level": "MANDATORY",
          "criteria": { "min": null, "max": 0.035, "unit": "%", "rounding_decimals": 3 }
        },
        {
          "rule_id": "CHEM_06Cr19Ni10_S",
          "category": "chemical",
          "property_key": "S",
          "display_name": "硫含量 (S)",
          "description": "依据 GB/T 13296-2023 表3，有害杂质元素硫质量分数应 <= 0.015% (2023新版由0.030%加严至0.015%)",
          "rule_type": "numeric_range",
          "requirement_level": "MANDATORY",
          "criteria": { "min": null, "max": 0.015, "unit": "%", "rounding_decimals": 3 }
        },
        {
          "rule_id": "CHEM_06Cr19Ni10_Ni",
          "category": "chemical",
          "property_key": "Ni",
          "display_name": "镍含量 (Ni)",
          "description": "依据 GB/T 13296-2023 表3，主要奥氏体稳定元素镍质量分数应在 8.00% ~ 11.00% 范围内",
          "rule_type": "numeric_range",
          "requirement_level": "MANDATORY",
          "criteria": { "min": 8.00, "max": 11.00, "unit": "%", "rounding_decimals": 2 }
        },
        {
          "rule_id": "CHEM_06Cr19Ni10_Cr",
          "category": "chemical",
          "property_key": "Cr",
          "display_name": "铬含量 (Cr)",
          "description": "依据 GB/T 13296-2023 表3，主要耐蚀合金元素铬质量分数应在 18.00% ~ 20.00% 范围内",
          "rule_type": "numeric_range",
          "requirement_level": "MANDATORY",
          "criteria": { "min": 18.00, "max": 20.00, "unit": "%", "rounding_decimals": 2 }
        },
        {
          "rule_id": "MECH_06Cr19Ni10_RM",
          "category": "mechanical",
          "property_key": "tensile_strength",
          "display_name": "抗拉强度 (Rm)",
          "description": "依据 GB/T 13296-2023 表4，常温抗拉强度 Rm 应 >= 520 MPa (若为热挤压工艺制造允许降低 20MPa)",
          "rule_type": "numeric_range",
          "requirement_level": "MANDATORY",
          "criteria": {
            "min": 520,
            "max": null,
            "unit": "MPa",
            "condition_adjustments": [
              {
                "when": "ctx.header.manufacturing_process == 'hot_extrusion'",
                "min_offset": -20,
                "note": "热挤压钢管抗拉强度允许降低20MPa"
              }
            ]
          }
        },
        {
          "rule_id": "MECH_06Cr19Ni10_RP02",
          "category": "mechanical",
          "property_key": "yield_strength_rp02",
          "display_name": "规定塑性延伸强度 (Rp0.2)",
          "description": "依据 GB/T 13296-2023 表4，常温屈服/规定塑性延伸强度 Rp0.2 应 >= 205 MPa",
          "rule_type": "numeric_range",
          "requirement_level": "MANDATORY",
          "criteria": { "min": 205, "max": null, "unit": "MPa" }
        },
        {
          "rule_id": "MECH_06Cr19Ni10_A",
          "category": "mechanical",
          "property_key": "elongation_A",
          "display_name": "断后伸长率 (A)",
          "description": "依据 GB/T 13296-2023 表4，断后伸长率 A (标距L0=5.65√S0) 应 >= 35%",
          "rule_type": "numeric_range",
          "requirement_level": "MANDATORY",
          "criteria": { "min": 35, "max": null, "unit": "%" }
        },
        {
          "rule_id": "MECH_06Cr19Ni10_HARDNESS",
          "category": "mechanical",
          "property_key": "hardness",
          "display_name": "硬度试验 (HRB/HBW/HV)",
          "description": "依据 GB/T 13296-2023 第 7.4.2 条及表5，壁厚 >= 1.7mm 的钢管应进行硬度试验，HRB <= 90 / HBW <= 192 / HV <= 200 任选其一合格即可",
          "rule_type": "or_choice_group",
          "requirement_level": "CONDITIONAL",
          "trigger_condition": "ctx.header.dimensions.wall_thickness_mm >= 1.7",
          "criteria": {
            "options": [
              { "sub_key": "HRB", "rule_type": "numeric_range", "criteria": { "max": 90, "unit": "HRB" } },
              { "sub_key": "HBW", "rule_type": "numeric_range", "criteria": { "max": 192, "unit": "HBW" } },
              { "sub_key": "HV",  "rule_type": "numeric_range", "criteria": { "max": 200, "unit": "HV" } }
            ]
          }
        },
        {
          "rule_id": "PROC_FLATTENING",
          "category": "process",
          "property_key": "flattening_test",
          "display_name": "压扁试验",
          "description": "依据 GB/T 13296-2023 第 7.6.1 条，壁厚 <= 10mm 钢管应按 GB/T 246 进行压扁试验，两平板间距 H=(1+0.09)S/(0.09+S/D)，压扁后试样无裂纹或裂口",
          "rule_type": "dynamic_formula_pass",
          "requirement_level": "MANDATORY",
          "trigger_condition": "ctx.header.dimensions.wall_thickness_mm <= 10.0",
          "criteria": {
            "formula_distance_H": "(1 + 0.09) * S / (0.09 + S / D)",
            "expected_visual_result": "NO_CRACKS",
            "test_standard": "GB/T 246"
          }
        },
        {
          "rule_id": "NDT_PRESSURE_TIGHTNESS",
          "category": "ndt",
          "property_key": "pressure_tightness",
          "display_name": "承压/致密性检验 (水压或涡流)",
          "description": "依据 GB/T 13296-2023 第 7.5 条，钢管应逐根进行液压试验；供方可用符合 GB/T 7735-2016 中 E3H 级的涡流检测代替液压试验",
          "rule_type": "alternative_group",
          "requirement_level": "MANDATORY",
          "criteria": {
            "group_logic": "AT_LEAST_ONE_PASS",
            "candidates": [
              {
                "candidate_key": "hydraulic_test",
                "display_name": "液压试验",
                "test_standard": "GB/T 241"
              },
              {
                "candidate_key": "eddy_current_test",
                "display_name": "涡流检测",
                "required_level": "E3H",
                "test_standard": "GB/T 7735-2016"
              }
            ]
          }
        },
        {
          "rule_id": "NDT_ULTRASONIC",
          "category": "ndt",
          "property_key": "ultrasonic_test",
          "display_name": "超声检测",
          "description": "依据 GB/T 13296-2023 第 7.9 条，钢管应按 GB/T 5777-2019 进行纵向超声波检测，验收等级应符合 U2 级要求",
          "rule_type": "enum_acceptance",
          "requirement_level": "MANDATORY",
          "criteria": { "required_level": "U2", "test_standard": "GB/T 5777-2019" }
        },
        {
          "rule_id": "CORROSION_INTERGRANULAR",
          "category": "corrosion",
          "property_key": "intergranular_corrosion",
          "display_name": "晶间腐蚀试验",
          "description": "依据 GB/T 13296-2023 第 7.7 条，06Cr19Ni10 应按 GB/T 4334-2020 E法进行晶间腐蚀试验，试样弯曲后不得有晶间腐蚀倾向",
          "rule_type": "qualitative_pass",
          "requirement_level": "MANDATORY",
          "criteria": { "method": "Method_E", "test_standard": "GB/T 4334-2020", "expected": "NO_CORROSION_TREND" }
        }
      ]
    },
    {
      "grade_info": {
        "primary_grade": "07Cr19Ni11Ti",
        "unified_code": "S32169",
        "structure_type": "austenitic"
      },
      "description": "07Cr19Ni11Ti (S32169) 含钛稳定化奥氏体不锈钢，通过钛固定碳元素防止晶界贫铬腐蚀，适用于高温工况",
      "evaluation_rules": [
        {
          "rule_id": "CHEM_07Cr19Ni11Ti_C",
          "category": "chemical",
          "property_key": "C",
          "display_name": "碳含量 (C)",
          "description": "依据 GB/T 13296-2023 表3，07Cr19Ni11Ti 碳质量分数应在 0.04% ~ 0.10% 范围内",
          "rule_type": "numeric_range",
          "requirement_level": "MANDATORY",
          "criteria": { "min": 0.04, "max": 0.10, "unit": "%", "rounding_decimals": 3 }
        },
        {
          "rule_id": "CHEM_07Cr19Ni11Ti_TI_DYNAMIC",
          "category": "chemical",
          "property_key": "Ti",
          "display_name": "钛含量 (Ti 动态公式)",
          "description": "依据 GB/T 13296-2023 表3，钛作为稳定化元素，其质量分数下限动态满足 Ti >= 4*(C+N)，且上限 <= 0.70%",
          "rule_type": "dynamic_expression",
          "requirement_level": "MANDATORY",
          "criteria": {
            "formula_min": "4 * (ctx.chemical.C + ctx.chemical.N)",
            "max": 0.70,
            "unit": "%",
            "rounding_decimals": 3,
            "note": "Ti: 4*(C+N) ~ 0.70%"
          }
        },
        {
          "rule_id": "METALLO_GRAIN_SIZE",
          "category": "metallographic",
          "property_key": "grain_size",
          "display_name": "晶粒度级别",
          "description": "依据 GB/T 13296-2023 第 7.8 条，含钛钢管平均晶粒度按 GB/T 6394 检验应在 4.0 ~ 7.0 级",
          "rule_type": "numeric_range",
          "requirement_level": "MANDATORY",
          "criteria": { "min": 4.0, "max": 7.0, "unit": "级" }
        },
        {
          "rule_id": "CORROSION_INTERGRANULAR_EXEMPT",
          "category": "corrosion",
          "property_key": "intergranular_corrosion",
          "display_name": "晶间腐蚀试验 (免做项)",
          "description": "依据 GB/T 13296-2023 第 7.7.1 条明确规定，07Cr19Ni11Ti 牌号可不进行晶间腐蚀试验",
          "rule_type": "exemption",
          "requirement_level": "EXEMPT",
          "criteria": { "reason": "标准 7.7.1 明确规定 07Cr19Ni11Ti 等牌号可不进行晶间腐蚀试验" }
        }
      ]
    }
  ]
}
